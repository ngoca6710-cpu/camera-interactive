<!-- ================= MEDIAPIPE ================= -->

<script type="module">

import {
    FilesetResolver,
    HandLandmarker
}
from "https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.22/+esm";


/* =========================================
   DOM
========================================= */

const video =
document.getElementById("camera");

const cursor =
document.getElementById("handCursor");

const body =
document.getElementById("body");

const module =
document.getElementById("module");

const handle =
document.getElementById("handle");

const module2 =
document.getElementById("module2");

const status =
document.getElementById("status");

const result =
document.getElementById("result");


/* =========================================
   VARIABLES
========================================= */

let handLandmarker;

let lastVideoTime = -1;

let started = false;

let interaction = 0;

let previousX = 0;

let previousY = 0;


/* =========================================
   START CAMERA
========================================= */

async function startCamera(){

    try{

        const stream =
        await navigator.mediaDevices.getUserMedia({
            video:{
                width:1280,
                height:720,
                facingMode:"user"
            },
            audio:false
        });

        video.srcObject = stream;

        await video.play();

        status.textContent =
        "CAMERA: ON / HAND TRACKING";

        started = true;

        detect();

    }

    catch(error){

        console.error(error);

        status.textContent =
        "CAMERA ERROR — HÃY CHẠY TRÊN HTTPS / LOCALHOST";

        alert(
            "Không thể mở camera.\n\n" +
            "Nếu bạn đang mở file index.html bằng double-click, " +
            "hãy chạy bằng GitHub Pages hoặc Live Server."
        );

    }

}


/* =========================================
   LOAD HAND LANDMARKER
========================================= */

async function createHandTracker(){

    status.textContent =
    "AI: ĐANG TẢI HAND TRACKING...";

    const vision =
    await FilesetResolver.forVisionTasks(
        "https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.22/wasm"
    );


    handLandmarker =
    await HandLandmarker.createFromOptions(
        vision,
        {

            baseOptions:{
                modelAssetPath:
                "https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task",

                delegate:"GPU"
            },

            runningMode:"VIDEO",

            numHands:1,

            minHandDetectionConfidence:0.5,

            minHandPresenceConfidence:0.5,

            minTrackingConfidence:0.5

        }
    );


    status.textContent =
    "AI: READY";

    startCamera();

}


/* =========================================
   DISTANCE
========================================= */

function distance(a,b){

    const dx = a.x-b.x;

    const dy = a.y-b.y;

    return Math.sqrt(
        dx*dx+dy*dy
    );

}


/* =========================================
   HAND OPEN DETECTION
========================================= */

function handOpen(hand){

    /*
       Khoảng cách đầu ngón tay
       tới lòng bàn tay.

       Không dùng để xác định
       người khuyết tật.
       Chỉ dùng để nhận dạng
       gesture.
    */

    const wrist =
    hand[0];

    const index =
    hand[8];

    const middle =
    hand[12];

    const ring =
    hand[16];

    const pinky =
    hand[20];

    const d1 =
    distance(wrist,index);

    const d2 =
    distance(wrist,middle);

    const d3 =
    distance(wrist,ring);

    const d4 =
    distance(wrist,pinky);

    return (
        d1>0.22 &&
        d2>0.22 &&
        d3>0.20 &&
        d4>0.18
    );

}


/* =========================================
   UPDATE OBJECT
========================================= */

function updateObject(hand){

    /*
       INDEX FINGER
       làm con trỏ.

       Camera bị mirror,
       nên X được đảo lại.
    */

    const index =
    hand[8];

    const x =
    1-index.x;

    const y =
    index.y;


    /* =========================
       CURSOR POSITION
    ========================= */

    const stage =
    document.getElementById("stage");

    const rect =
    stage.getBoundingClientRect();

    const screenX =
    x*rect.width;

    const screenY =
    y*rect.height;


    cursor.style.display="block";

    cursor.style.left =
    screenX+"px";

    cursor.style.top =
    screenY+"px";


    /* =========================
       HANDLE FOLLOW HAND
    ========================= */

    let handleX =
    x*300-50;

    let handleY =
    y*330-60;


    handleX =
    Math.max(0,
    Math.min(265,handleX));

    handleY =
    Math.max(0,
    Math.min(265,handleY));


    handle.style.left =
    handleX+"px";

    handle.style.top =
    handleY+"px";


    /* =========================
       HAND MOVEMENT
    ========================= */

    const movement =
    Math.abs(x-previousX)+
    Math.abs(y-previousY);


    if(movement>0.015){

        interaction++;

    }


    previousX=x;

    previousY=y;


    /* =========================
       OPEN HAND
    ========================= */

    if(handOpen(hand)){

        body.style.width =
        "260px";

        body.style.height =
        "290px";

        body.style.borderRadius =
        "30px";

        module.style.width =
        "150px";

        module.style.height =
        "65px";

        module2.style.width =
        "300px";

    }

    else{

        body.style.width =
        "210px";

        body.style.height =
        "250px";

        body.style.borderRadius =
        "0";

        module.style.width =
        "90px";

        module.style.height =
        "45px";

        module2.style.width =
        "270px";

    }


    /* =========================
       ROTATION
    ========================= */

    const wrist =
    hand[0];

    const middle =
    hand[9];

    const angle =
    Math.atan2(
        middle.y-wrist.y,
        middle.x-wrist.x
    )*180/Math.PI;


    handle.style.transform =
    "rotate("+angle+"deg)";


    /* =========================
       MODULE FOLLOW
    ========================= */

    module.style.left =
    (x*300-45)+"px";

    module.style.top =
    (y*250-50)+"px";


    /* =========================
       PURPLE MODULE
    ========================= */

    module2.style.transform =
    "translateX("+
    ((x-.5)*150)+
    "px)";


    /* =========================
       FINISH
    ========================= */

    if(interaction>300){

        result.style.display =
        "flex";

    }

}


/* =========================================
   DETECTION LOOP
========================================= */

async function detect(){

    if(
        !started ||
        !handLandmarker
    ){

        requestAnimationFrame(detect);

        return;

    }


    if(
        video.readyState >= 2 &&
        video.currentTime !== lastVideoTime
    ){

        lastVideoTime =
        video.currentTime;


        const results =
        handLandmarker.detectForVideo(
            video,
            performance.now()
        );


        if(
            results.landmarks &&
            results.landmarks.length>0
        ){

            updateObject(
                results.landmarks[0]
            );

        }

        else{

            cursor.style.display =
            "none";

            status.textContent =
            "AI: ĐƯA TAY VÀO CAMERA";

        }

    }


    requestAnimationFrame(detect);

}


/* =========================================
   RUN
========================================= */

createHandTracker();

</script>

