    line-height:.82;

    letter-spacing:-5px;

    font-weight:900;
}

.orange{
    color:#FF5A00;
}

.description{
    margin-top:25px;

    width:320px;

    font-family:monospace;

    font-size:13px;

    line-height:1.5;
}

/* ================= STAGE ================= */

#stage{
    position:absolute;

    left:50%;
    top:50%;

    transform:translate(-50%,-48%);

    width:600px;
    height:480px;

    border:2px solid #111;

    overflow:hidden;

    background:
        linear-gradient(#ddd 1px,transparent 1px),
        linear-gradient(90deg,#ddd 1px,transparent 1px);

    background-size:30px 30px;
}

/* ================= OBJECT ================= */

#object{
    position:absolute;

    left:50%;
    top:50%;

    width:300px;
    height:330px;

    transform:translate(-50%,-50%);
}

/* Main body */

.body{
    position:absolute;

    left:45px;
    top:45px;

    width:210px;
    height:250px;

    background:#D6D2C8;

    border:5px solid #111;

    transition:
        width .25s,
        height .25s,
        border-radius .25s,
        transform .25s;
}

/* Orange module */

.module{
    position:absolute;

    width:90px;
    height:45px;

    background:#FF5A00;

    border:5px solid #111;

    transition:
        left .15s,
        top .15s,
        width .2s,
        height .2s,
        border-radius .2s,
        transform .2s;
}

/* Handle */

.handle{
    position:absolute;

    left:132px;
    top:112px;

    width:36px;
    height:125px;

    background:#111;

    border:0;

    transition:
        left .15s,
        top .15s,
        width .2s,
        height .2s,
        transform .2s,
        border-radius .2s;
}

.handle::after{
    content:"";

    position:absolute;

    left:8px;
    top:20px;

    width:20px;
    height:82px;

    background:#FF5A00;
}

/* Purple module */

.module2{
    position:absolute;

    left:15px;
    top:300px;

    width:270px;
    height:28px;

    background:#6F00FF;

    border:4px solid #111;

    transition:
        width .2s,
        left .2s,
        transform .2s;
}

/* ================= HAND CURSOR ================= */

#handCursor{
    position:absolute;

    width:28px;
    height:28px;

    border-radius:50%;

    background:#FF0087;

    border:4px solid #111;

    pointer-events:none;

    z-index:20;

    display:none;

    transform:translate(-50%,-50%);
}

/* ================= INSTRUCTION ================= */

.instruction{
    position:absolute;

    left:30px;
    bottom:30px;

    font-family:monospace;

    font-size:12px;

    z-index:5;
}

/* ================= RIGHT PANEL ================= */

.panel{
    position:absolute;

    right:25px;
    bottom:30px;

    width:240px;

    font-family:monospace;

    font-size:11px;

    line-height:1.5;
}

.panel-title{
    font-weight:bold;

    border-bottom:2px solid #111;

    padding-bottom:7px;

    margin-bottom:8px;
}

.panel div{
    padding:7px 0;

    border-bottom:1px solid #999;
}

/* ================= RESULT ================= */

#result{
    position:fixed;

    inset:0;

    background:#F2F0E8;

    z-index:100;

    display:none;

    align-items:center;

    justify-content:center;

    text-align:center;
}

.result-content{
    max-width:900px;

