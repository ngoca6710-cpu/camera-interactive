    document.getElementById("moduleC").style.top = "350px";
    document.getElementById("moduleC").style.borderRadius = "0";
    document.getElementById("moduleC").style.transform = "rotate(0deg)";

}

function closeResult() {

    document.getElementById("result").style.display = "none";

}

