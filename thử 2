<script>

let selectedObject = "door";
let interactionCount = 0;

const objectData = {

    door: {
        name: "OBJECT 01 — CÁNH CỬA",
        colors: ["#FF5A00", "#111111", "#6F00FF"]
    },

    faucet: {
        name: "OBJECT 02 — VÒI NƯỚC",
        colors: ["#6F00FF", "#111111", "#FF5A00"]
    },

    switch: {
        name: "OBJECT 03 — CÔNG TẮC",
        colors: ["#FF0087", "#111111", "#FF5A00"]
    },

    elevator: {
        name: "OBJECT 04 — NÚT THANG MÁY",
        colors: ["#FF5A00", "#6F00FF", "#111111"]
    }

};

const parts = document.querySelectorAll(".part");

function registerInteraction() {

    interactionCount++;

    document.getElementById("count").textContent = interactionCount;

    if (interactionCount >= 12) {
        document.getElementById("result").style.display = "flex";
    }
}

parts.forEach(part => {

    let dragging = false;
    let offsetX = 0;
    let offsetY = 0;

    part.addEventListener("pointerdown", function(e) {

        dragging = true;

        const rect = part.getBoundingClientRect();

        offsetX = e.clientX - rect.left;
        offsetY = e.clientY - rect.top;

        part.setPointerCapture(e.pointerId);

    });

    part.addEventListener("pointermove", function(e) {

        if (!dragging) return;

        const object = document.getElementById("object");
        const objectRect = object.getBoundingClientRect();

        let x = e.clientX - objectRect.left - offsetX;
        let y = e.clientY - objectRect.top - offsetY;

        x = Math.max(-30, Math.min(objectRect.width - 30, x));
        y = Math.max(-30, Math.min(objectRect.height - 30, y));

        part.style.left = x + "px";
        part.style.top = y + "px";

    });

    part.addEventListener("pointerup", function() {

        if (dragging) {
            registerInteraction();
        }

        dragging = false;

    });

    part.addEventListener("dblclick", function() {

        registerInteraction();

        const currentRadius = part.style.borderRadius;

        if (currentRadius === "50%") {

            part.style.borderRadius = "0";
            part.style.transform = "rotate(0deg)";

        } else {

            part.style.borderRadius = "50%";
            part.style.transform = "rotate(25deg)";

        }

    });

});

function changeObject(type) {

    selectedObject = type;

    const data = objectData[type];

    document.getElementById("objectName").textContent = data.name;

    document.getElementById("moduleA").style.background = data.colors[0];
    document.getElementById("moduleB").style.background = data.colors[1];
    document.getElementById("moduleC").style.background = data.colors[2];

    resetObject();

}

function resetObject() {

