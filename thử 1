""",encoding="utf-8")

zip_path=Path("/mnt/data/DUNG_DUOC_OBJECT_LAB.zip")
with zipfile.ZipFile(zip_path,"w",zipfile.ZIP_DEFLATED) as z:
    z.write(root/"index.html","index.html")
    z.write(root/"README.txt","README.txt")
print(zip_path)
