from pathlib import Path
import zipfile

root = Path("/mnt/data/dung_duoc_object_lab")
root.mkdir(exist_ok=True)

html = r'''<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>DÙNG ĐƯỢC? — OBJECT LAB</title>
<style>
:root{--bg:#f4f2ea;--ink:#111;--orange:#ff5a00;--purple:#6f00ff;--pink:#ff0087}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:Arial,Helvetica,sans-serif;overflow:hidden}
header,footer{height:72px;border-bottom:2px solid var(--ink);display:flex;align-items:center;justify-content:space-between;padding:0 28px}
footer{border-top:2px solid var(--ink);border-bottom:0;height:58px;font:12px monospace}
.logo{font-size:23px;font-weight:1000}.case{font:12px monospace}
main{height:calc(100vh - 130px);position:relative;display:grid;place-items:center}
#lab{width:min(1120px,94vw);height:min(700px,80vh);position:relative}
#title{position:absolute;top:0;left:0;font-size:clamp(28px,4vw,58px);font-weight:1000;line-height:.9;z-index:3}
#instruction{position:absolute;right:0;top:8px;width:260px;font:14px/1.45 monospace;text-align:right;z-index:3}
#object{position:absolute;left:50%;top:53%;transform:translate(-50%,-50%);width:430px;height:470px}
.part{position:absolute;border:5px solid var(--ink);background:#ddd;cursor:grab;user-select:none;touch-action:none;transition:.18s}
.part:active{cursor:grabbing}
#body{width:270px;height:330px;left:80px;top:55px;background:#d9d6cd}
#top{width:300px;height:70px;left:65px;top:20px;background:var(--orange)}
#handle{width:95px;height:180px;left:175px;top:125px;background:var(--ink);border:0}
#handle:after{content:"";position:absolute;left:25px;top:25px;width:45px;height:130px;background:var(--orange)}
#foot{width:300px;height:35px;left:65px;bottom:35px;background:var(--purple)}
#hint{position:absolute;bottom:0;left:0;font:12px monospace}
#tools{position:absolute;right:0;bottom:20px;width:245px}
.tool{display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid #777;font:12px monospace}
.dot{width:22px;height:22px;border:2px solid var(--ink);background:var(--orange)}
#message{position:absolute;inset:0;background:rgba(244,242,234,.96);z-index:20;display:none;align-items:center;justify-content:center;text-align:center}
.msg{max-width:800px;padding:30px}.big{font-size:clamp(48px,8vw,100px);font-weight:1000;line-height:.85}
button{background:var(--ink);color:#fff;border:0;padding:13px 20px;font-weight:900;cursor:pointer}
#camera{position:fixed;right:18px;bottom:76px;width:190px;height:125px;object-fit:cover;display:none;border:2px solid var(--ink);transform:scaleX(-1);z-index:50}
#cursor{position:fixed;width:18px;height:18px;background:var(--pink);border-radius:50%;pointer-events:none;display:none;z-index:60;transform:translate(-50%,-50%)}
</style>
</head>
<body>
<header><div class="logo">DÙNG ĐƯỢC?</div><div class="case">OBJECT LAB / 001</div></header>

<main>
<div id="lab">
  <div id="title">MỘT VẬT.<br><span style="color:var(--orange)">NHIỀU CÁCH DÙNG.</span></div>
  <div id="instruction">ĐỪNG CHỌN.<br>HÃY KÉO.<br><br>THỬ THAY ĐỔI HÌNH DẠNG CỦA VẬT THỂ.</div>

  <div id="object">
    <div class="part" id="body"></div>
    <div class="part" id="top"></div>
    <div class="part" id="handle"></div>
    <div class="part" id="foot"></div>
  </div>

  <div id="hint">KÉO CÁC BỘ PHẬN • DOUBLE CLICK ĐỂ BIẾN HÌNH</div>

  <div id="tools">
    <div class="tool"><span class="dot"></span> MODULE — HÌNH DẠNG</div>
    <div class="tool"><span class="dot" style="background:var(--purple)"></span> MODULE — CHỨC NĂNG</div>
    <div class="tool"><span class="dot" style="background:var(--pink)"></span> USER INTERVENTION</div>
  </div>
</div>

<div id="message"><div class="msg">
  <div class="big">BẠN VỪA TẠO<br><span style="color:var(--orange)">MỘT CÁCH DÙNG.</span></div>
  <p style="font:17px/1.5 monospace">Không có một hình dạng duy nhất.<br>Không có một cách sử dụng duy nhất.</p>
  <p style="font-size:22px;font-weight:900">NHƯNG — NÓ CÓ <span style="color:var(--orange)">DÙNG ĐƯỢC</span> VỚI NGƯỜI KHÁC KHÔNG?</p>
  <button onclick="location.reload()">THỬ MỘT VẬT KHÁC</button>
</div></div>
</main>

<footer>
  <div id="status">MOUSE / TRACKPAD MODE</div>
  <button id="camBtn">BẬT CAMERA</button>
</footer>
<video id="camera" autoplay muted playsinline></video><div id="cursor"></div>

<script>
const parts=[...document.querySelectorAll('.part')], obj=document.getElementById('object');
let drag=null, ox=0,oy=0,changes=0,cam=false;

parts.forEach(p=>{
 p.addEventListener('pointerdown',e=>{
   drag=p; const r=p.getBoundingClientRect();
   ox=e.clientX-r.left;oy=e.clientY-r.top;p.setPointerCapture(e.pointerId);
 });
 p.addEventListener('pointermove',e=>{
   if(!drag)return;
   const r=obj.getBoundingClientRect();
   let x=e.clientX-r.left-ox,y=e.clientY-r.top-oy;
   x=Math.max(-70,Math.min(r.width-30,x));y=Math.max(-70,Math.min(r.height-20,y));
   drag.style.left=x+'px';drag.style.top=y+'px';changes++;
   if(changes>120) document.getElementById('message').style.display='flex';
 });
 p.addEventListener('pointerup',()=>{drag=null});
 p.addEventListener('pointercancel',()=>{drag=null});
 p.addEventListener('dblclick',()=>{
   changes++;
   if(p.id==='handle'){
     p.style.width=p.style.width==='180px'?'95px':'180px';
     p.style.height=p.style.height==='95px'?'180px':'95px';
     p.style.borderRadius=p.style.borderRadius==='50%'?'0':'50%';
   }else{
     p.style.borderRadius=p.style.borderRadius==='45px'?'0':'45px';
   }
 });
});

const camBtn=document.getElementById('camBtn'),video=document.getElementById('camera');
camBtn.onclick=async()=>{
 try{
  const stream=await navigator.mediaDevices.getUserMedia({video:true,audio:false});
  video.srcObject=stream;video.style.display='block';
  document.getElementById('status').textContent='CAMERA ON — bản prototype vẫn dùng chuột để kéo';
  camBtn.textContent='CAMERA ĐANG BẬT';
 }catch(e){document.getElementById('status').textContent='KHÔNG MỞ ĐƯỢC CAMERA — dùng chuột/trackpad';}
};
</script>
</body>
</html>'''

(root/"index.html").write_text(html,encoding="utf-8")
(root/"README.txt").write_text(
"""DÙNG ĐƯỢC? — OBJECT LAB
